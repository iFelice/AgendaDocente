# Server runtime. Render supplies PORT; required in production.
NODE_ENV=development
PORT=3000
# Optional SECRET: set only on the server. Empty disables cloud AI.
GEMINI_API_KEY=
# Local Vite development only.
DISABLE_HMR=false

# PUBLIC Firebase web config, embedded by Vite at build time.
# Leave ALL empty to run the local agenda without Google login.
# Copy values from your Firebase web app settings; rebuild after changes.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Never put Gemini keys, OAuth client secrets or tokens in VITE_* variables.
