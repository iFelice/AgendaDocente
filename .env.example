# Server runtime. Render supplies PORT; required in production.
NODE_ENV=development
PORT=3000
# Optional SECRET: set only on the server. Empty disables cloud AI.
GEMINI_API_KEY=
# Optional: comma-separated Gemini models actually tried by document analysis
# (server only, max 5). Use it to test availability of a model on the deployed
# key without rebuilding; invalid values fall back to the defaults.
GEMINI_CANDIDATE_MODELS=
# Optional: Groq Vision fallback for /api/analyze-timetable ONLY. Server only,
# never in a VITE_* variable. Used after Gemini exhausts its attempts on a
# TRANSIENT failure (503/429/timeout/network) and only for PNG/JPEG/WebP.
# Leave empty to keep the current Gemini-only behaviour.
GROQ_API_KEY=
# Optional: Groq model used by that fallback (server only, max 64 chars).
GROQ_VISION_MODEL=
# Local Vite development only.
DISABLE_HMR=false

# PUBLIC Firebase web config, embedded by Vite at build time.
# Leave ALL empty to run the local agenda without Google login.
# Copy values from your Firebase web app settings; rebuild after changes.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Never put Gemini keys, OAuth client secrets or tokens in VITE_* variables.
